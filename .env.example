# Server Configuration (Render assigns $PORT dynamically)
PORT=8080

# Database Configuration (Neon, Render PostgreSQL, or local)
# Note for Neon: ensure prefix is 'jdbc:postgresql://' and includes '?sslmode=require'
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=your_neon_db_username
SPRING_DATASOURCE_PASSWORD=your_neon_db_password

# Hibernate & Schema Management
SPRING_JPA_SHOW_SQL=false
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Session Cookie Configuration
# For local dev / same-site proxy: SECURE=false, SAME_SITE=lax
# For cross-origin production (HTTPS): SECURE=true, SAME_SITE=none
SERVER_SERVLET_SESSION_COOKIE_SECURE=false
SERVER_SERVLET_SESSION_COOKIE_SAME_SITE=lax

# CORS Allowed Origins (Comma-separated; do NOT use '*' when credentials are true)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app

# Optional CSRF Protection toggle (default false for REST/SPA; set true to enforce CookieCsrfTokenRepository)
APP_SECURITY_CSRF_ENABLED=false
